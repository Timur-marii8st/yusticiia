# Скопируйте в .env и заполните при необходимости.
# НИКОГДА не коммитьте .env и реальные ключи.

# Каталог изменяемых данных (документы, отчёты, аудит). По умолчанию: ./data/store
SO_DATA_DIR=

# Каталог фикстур (нормы, дела, образцы документов). По умолчанию: ./data/fixtures
SO_FIXTURES_DIR=

# Провайдер языковой модели:
#   mock              — по умолчанию, полностью офлайн, наружу не ходит
#   openai_compatible — модель, развёрнутая в закрытом контуре (vLLM, Ollama)
#
# Облачных провайдеров нет: Концепция ВС РФ по ИИ (приказ № 59-П) запрещает
# передачу текстов в публичные облака. Адрес модели проверяется при запуске:
# адрес вне сети суда останавливает сервис (src/second_opinion/llm/contour.py).
SO_LLM_PROVIDER=mock

# --- локальная модель: Ollama --------------------------------------------
# Изолированный контур: документы не покидают машину вовсе. Тот же путь,
# на котором 20.09.2026 сделан замер (evaluation/llm_extraction_probe.py):
# см. результаты в docs/CONCEPT.md, раздел «Алгоритмы». Для разовой пробы
# на рабочей станции — не для нагрузки сервера в проде, см. vLLM ниже.
#   ollama serve
#   ollama pull qwen2.5:7b-instruct
# SO_LLM_PROVIDER=openai_compatible
# SO_OPENAI_BASE_URL=http://127.0.0.1:11434/v1
# SO_OPENAI_API_KEY=local
# SO_LLM_MODEL=qwen2.5:7b-instruct

# --- локальная модель: vLLM (сервер Linux с видеокартой NVIDIA) -----------
# Тот же изолированный контур и тот же протокол, что у Ollama выше: тот же
# OpenAICompatibleProvider, другой сервер. Это путь, которым «закрытый
# контур» из Концепции ВС РФ по ИИ (docs/TZ.md, раздел 2.10) закрывается
# без внешнего провайдера: модель работает в том же периметре, что и сама
# система. Пошаговая установка на Ubuntu - docs/DEPLOYMENT_VLLM.md,
# проверка сервера перед запуском - scripts/vllm_preflight.sh.
# Каждая переменная в рабочем .env должна встречаться один раз: при
# повторе действует последнее значение, в том числе пустое из блока ниже.
#
#   docker compose --profile vllm up -d
#
# SO_LLM_PROVIDER=openai_compatible
# SO_OPENAI_BASE_URL=http://vllm:8000/v1
# SO_OPENAI_API_KEY=<openssl rand -hex 24>
# SO_LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
#
# Ключ SO_OPENAI_API_KEY один на обе стороны: им же сервер vLLM закрывает
# адреса /v1 (--api-key), а приложение подписывает запросы.
# VLLM_IMAGE_TAG=v0.31.0-cu129
# VLLM_MAX_MODEL_LEN=16384
# VLLM_GPU_MEMORY_UTILIZATION=0.90
# VLLM_GENERATION_CONFIG=vllm
# HF_HUB_OFFLINE=0
# HF_ENDPOINT=https://huggingface.co

# --- адрес модели (только внутри закрытого контура) -----------------------
# Допустимы localhost, частные адреса, имя сервиса Docker (vllm) и зоны
# .local, .internal, .lan. Внутренний сервер суда с обычным доменным именем
# перечисляется явно в SO_LLM_CONTOUR_HOSTS через запятую.
SO_OPENAI_BASE_URL=
SO_OPENAI_API_KEY=
SO_LLM_MODEL=
SO_LLM_CONTOUR_HOSTS=

# Лимит размера загружаемого документа (байты)
SO_MAX_UPLOAD_BYTES=5242880

# Режим поиска по базе источников: lexical (по умолчанию) | hybrid |
# hybrid_pgvector — гибрид с хранением векторов в PostgreSQL/pgvector
# (требует SO_STORAGE_BACKEND=postgres и SO_DATABASE_URL).
# В hybrid_pgvector лексическое ранжирование уточняется ANN-поиском в БД.
SO_RAG_MODE=lexical

# Провайдер векторизации для hybrid-режима: hashing (детерминированный,
# офлайн) | openai_compatible (сервер векторизации в закрытом контуре; адрес
# проверяется так же, как адрес модели)
SO_EMBEDDINGS_PROVIDER=hashing

# Имя модели для openai_compatible-провайдера эмбеддингов
# (ключ и базовый URL берутся из SO_OPENAI_API_KEY / SO_OPENAI_BASE_URL)
SO_EMBEDDING_MODEL=

# Общий секрет доступа к /api/* (Bearer-токен). Пусто — авторизация
# выключена (режим loopback-MVP). Задавайте при любом сетевом доступе.
# Режим авторизации /api/* (ФТ-40):
#   open     — доступ без авторизации: демонстрация на loopback;
#   shared   — общий секрет ИЛИ личная учётная запись;
#   accounts — только личная учётная запись; общий секрет отвергается.
# Пусто — режим выводится из SO_AUTH_TOKEN: задан → shared, пуст → open.
# В судебной системе рубильником должна быть учётная запись: под общим
# секретом все записи в аудит-журнале обезличены.
SO_AUTH_MODE=

# Минимальная длина пароля пользователя. Для первого администратора
# действует отдельный порог в 12 символов.
SO_PASSWORD_MIN_LENGTH=8

SO_AUTH_TOKEN=

# Ключ подписи JWT личных учётных записей. Отдельный от SO_AUTH_TOKEN:
# общий Bearer раздаётся операторам, и знание его не должно позволять
# подписать токен с ролью admin. Минимум 32 байта (RFC 7518 §3.2).
# Пусто — случайный ключ на время жизни процесса: подделать нельзя, но
# после перезапуска все выданные токены недействительны.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SO_JWT_SECRET=

# 1 — не запускать сервер на внешнем адресе с пустым SO_AUTH_TOKEN
# (по умолчанию выводится предупреждение, запуск продолжается).
SO_REQUIRE_AUTH=

# Пароль первого администратора для `second-opinion create-admin`.
# Разовая величина для бутстрапа: в постоянной конфигурации не хранится,
# при пустом значении пароль запрашивается в терминале.
SO_ADMIN_PASSWORD=

# Новый пароль для `second-opinion reset-password`. Разовая величина: в постоянной
# конфигурации не хранится, при пустом значении пароль запрашивается в терминале.
SO_NEW_PASSWORD=

# Ограничение частоты входа: попыток с одного клиента за окно (0 — снять).
# Блокировка учётки (SO_LOGIN_MAX_ATTEMPTS) считает неудачи по конкретному
# пользователю и потому не сдерживает перебор по списку адресов.
# За обратным прокси все запросы приходят с одного адреса — ставьте лимит
# на самом прокси.
SO_LOGIN_RATE_LIMIT=20
SO_LOGIN_RATE_WINDOW_SECONDS=60

# Ограничения на запуск анализа. Частота считается на пользователя за окно
# (0 отключает); одновременных анализов не больше SO_ANALYZE_MAX_CONCURRENCY
# (0 отключает), ожидание свободного места SO_ANALYZE_QUEUE_SECONDS, затем 503.
# SO_LLM_MAX_TOKENS ограничивает длину ответа модели в одном запросе.
SO_ANALYZE_RATE_LIMIT=30
SO_ANALYZE_RATE_WINDOW_SECONDS=60
SO_ANALYZE_MAX_CONCURRENCY=4
SO_ANALYZE_QUEUE_SECONDS=30
SO_LLM_MAX_TOKENS=3000

# Источник редакционной истории норм: none (по умолчанию, выключен) |
# pravo (ИПС pravo.gov.ru, официальный, без токена) | garant (нужен токен) |
# stub (ответы из подготовленных файлов).
# Заглушка содержит ПРЕДПОЛОЖЕНИЯ по документации, а не ответы сервера.
SO_REDACTION_SOURCE=none

# Адрес ИПС «Законодательство России». Менять нужно только при работе
# через зеркало или прокси.
SO_PRAVO_BASE_URL=http://pravo.gov.ru/proxy/ips/

# Таймаут запроса к ИПС, секунды. Сервер отвечает медленно: около 16 с на
# страницу списка редакций, а полный текст УК РФ весит 2,6 МБ. На узком
# канале поднимайте до 600.
SO_PRAVO_TIMEOUT=180

# Носитель норм: file (по умолчанию — каталог фикстур, ревью через git и
# опечатанный манифест) | postgres (обновление нормы без выпуска релиза;
# требует SO_DATABASE_URL и группу зависимостей [pg]).
# В базе целостность обеспечивают аудит-журнал и права доступа, а не
# контрольные суммы файлов.
SO_NORMS_BACKEND=file

# Базовый URL API ГАРАНТ. Не угадывается: документация приводит только пути
# вида /v2/..., хост сообщает обслуживающая организация вместе с токеном.
SO_GARANT_BASE_URL=

# OAuth-токен ГАРАНТ, выдаётся по заявке обслуживающей организацией.
SO_GARANT_TOKEN=

# Каталог файлов заглушки (по умолчанию data/fixtures/garant_stub).
SO_GARANT_STUB_DIR=

# Носитель документов/отчётов: file (по умолчанию, JSON в ./data/store) |
# postgres — JSONB в PostgreSQL (требует SO_DATABASE_URL).
SO_STORAGE_BACKEND=file
SO_DATABASE_URL=

# Включение внутренних метрик конвейера (1 — включить, иначе выключено).
# При включении эндпоинт GET /metrics возвращает снимок счётчиков и
# гистограмм; см. docs/API.md и src/second_opinion/metrics.py.
SO_METRICS_ENABLED=0

# Максимальный возраст пароля в днях (0 — без ограничения). При превышении
# вход отклоняется 403 «срок действия пароля истёк», пока оператор не
# задаст новый пароль командой reset-password.
# Пользователи: in-memory по умолчанию; при SO_STORAGE_BACKEND=postgres
# хранятся в PostgreSQL (таблица users + blacklist + аудит входов).
SO_PASSWORD_MAX_AGE_DAYS=0

# Глубина истории паролей (0 — не проверять повторы): повторное
# использование одного из последних паролей отклоняется 400.
SO_PASSWORD_HISTORY_DEPTH=5

# Блокировка входа: максимум последовательных неудачных попыток (0 — без
# блокировки) и длительность блокировки в минутах (заблокированный аккаунт
# отвечает так же, как неверный пароль: 401, сброс — успешный вход после
# истечения или смена/сброс пароля).
SO_LOGIN_MAX_ATTEMPTS=5
SO_LOGIN_LOCKOUT_MINUTES=15

# PostgreSQL в docker-compose (профиль postgres): пароль администратора БД и пароль
# роли so_app, которой подключается приложение. Значения по умолчанию - только
# для демонстрации на loopback. Роль создаётся при первом запуске пустого тома.
# SO_DB_ADMIN_PASSWORD=
# SO_DB_APP_PASSWORD=
# DSN приложения: postgresql://so_app:<SO_DB_APP_PASSWORD>@127.0.0.1:5432/second_opinion

# Документация API (/docs, /redoc, /openapi.json): по умолчанию только в режиме open;
# 1 - показывать всегда, 0 - не показывать никогда.
# SO_API_DOCS=

# 1 - всегда ставить Secure на cookie refresh-токена. Сервис за обратным прокси с TLS видит
# обычный HTTP, а браузер ходит по HTTPS: без этой переменной флаг Secure не ставится.
# SO_COOKIE_SECURE=

# Права пользователя контейнера приложения (по умолчанию 10001): каталог data/ на
# хосте должен принадлежать этому пользователю.
# SO_UID=
# SO_GID=
# Динамическое получение явно запрошенных статей УК РФ для поиска и анализа.
# none сохраняет автономный режим; pravo включает HTTP-клиент страниц ИПС.
SO_DYNAMIC_NORM_SOURCE=none
# История документа и полные тексты редакций перепроверяются раз в сутки.
SO_SOURCE_CACHE_TTL=86400
# Таймаут одного HTTP-запроса (0 < значение <= 30); одна повторная попытка.
SO_SOURCE_REQUEST_TIMEOUT=15
# Если HTTP-прокси вашей среды блокирует ИПС, проверьте прямой доступ отдельно.
# При подтверждённом прямом доступе добавьте pravo.gov.ru,.pravo.gov.ru
# к существующему NO_PROXY, сохранив остальные исключения.
