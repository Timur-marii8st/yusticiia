# Скопируйте в .env и заполните при необходимости.
# НИКОГДА не коммитьте .env и реальные ключи.

# Каталог изменяемых данных (документы, отчёты, аудит). По умолчанию: ./data/store
SO_DATA_DIR=

# Каталог фикстур (нормы, дела, образцы документов). По умолчанию: ./data/fixtures
SO_FIXTURES_DIR=

# LLM-провайдер: mock (по умолчанию, полностью офлайн) | openai_compatible
SO_LLM_PROVIDER=mock

# Параметры для openai_compatible (нужны только при явном включении внешнего контура)
SO_OPENAI_BASE_URL=
SO_OPENAI_API_KEY=
SO_LLM_MODEL=

# Лимит размера загружаемого документа (байты)
SO_MAX_UPLOAD_BYTES=5242880

# Режим поиска по базе источников: lexical (по умолчанию) | hybrid |
# hybrid_pgvector — гибрид с хранением векторов в PostgreSQL/pgvector
# (требует SO_STORAGE_BACKEND=postgres и SO_DATABASE_URL; ADR-006).
# В hybrid_pgvector лексическое ранжирование уточняется ANN-поиском в БД.
SO_RAG_MODE=lexical

# Провайдер векторизации для hybrid-режима: hashing (детерминированный,
# офлайн) | openai_compatible (внешний эндпоинт; отправляет тексты норм наружу)
SO_EMBEDDINGS_PROVIDER=hashing

# Имя модели для openai_compatible-провайдера эмбеддингов
# (ключ и базовый URL берутся из SO_OPENAI_API_KEY / SO_OPENAI_BASE_URL)
SO_EMBEDDING_MODEL=

# Общий секрет доступа к /api/* (Bearer-токен). Пусто — авторизация
# выключена (режим loopback-MVP). Задавайте при любом сетевом доступе.
SO_AUTH_TOKEN=

# Ключ подписи JWT личных учётных записей. Отдельный от SO_AUTH_TOKEN:
# общий Bearer раздаётся операторам, и знание его не должно позволять
# подписать токен с ролью admin. Минимум 32 байта (RFC 7518 §3.2).
# Пусто — случайный ключ на время жизни процесса: подделать нельзя, но
# после перезапуска все выданные токены недействительны.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SO_JWT_SECRET=

# 1 — не запускать сервер на внешнем адресе с пустым SO_AUTH_TOKEN
# (по умолчанию выводится предупреждение, запуск продолжается).
SO_REQUIRE_AUTH=

# Пароль первого администратора для `second-opinion create-admin`.
# Разовая величина для бутстрапа: в постоянной конфигурации не хранится,
# при пустом значении пароль запрашивается в терминале.
SO_ADMIN_PASSWORD=

# Ограничение частоты входа: попыток с одного клиента за окно (0 — снять).
# Блокировка учётки (SO_LOGIN_MAX_ATTEMPTS) считает неудачи по конкретному
# пользователю и потому не сдерживает перебор по списку адресов.
# За обратным прокси все запросы приходят с одного адреса — ставьте лимит
# на самом прокси.
SO_LOGIN_RATE_LIMIT=20
SO_LOGIN_RATE_WINDOW_SECONDS=60

# Источник редакционной истории норм: none (по умолчанию, выключен) |
# pravo (ИПС pravo.gov.ru, официальный, без токена) | garant (нужен токен) |
# stub (ответы из подготовленных файлов).
# Заглушка содержит ПРЕДПОЛОЖЕНИЯ по документации, а не ответы сервера.
SO_REDACTION_SOURCE=none

# Адрес ИПС «Законодательство России». Менять нужно только при работе
# через зеркало или прокси.
SO_PRAVO_BASE_URL=http://pravo.gov.ru/proxy/ips/

# Таймаут запроса к ИПС, секунды. Сервер отвечает медленно: около 16 с на
# страницу списка редакций, а полный текст УК РФ весит 2,6 МБ. На узком
# канале поднимайте до 600.
SO_PRAVO_TIMEOUT=180

# Носитель норм: file (по умолчанию — каталог фикстур, ревью через git и
# опечатанный манифест) | postgres (обновление нормы без выпуска релиза;
# требует SO_DATABASE_URL и группу зависимостей [pg]).
# В базе целостность обеспечивают аудит-журнал и права доступа, а не
# контрольные суммы файлов.
SO_NORMS_BACKEND=file

# Базовый URL API ГАРАНТ. Не угадывается: документация приводит только пути
# вида /v2/..., хост сообщает обслуживающая организация вместе с токеном.
SO_GARANT_BASE_URL=

# OAuth-токен ГАРАНТ, выдаётся по заявке обслуживающей организацией.
SO_GARANT_TOKEN=

# Каталог файлов заглушки (по умолчанию data/fixtures/garant_stub).
SO_GARANT_STUB_DIR=

# Носитель документов/отчётов: file (по умолчанию, JSON в ./data/store) |
# postgres — JSONB в PostgreSQL (ADR-006, требует SO_DATABASE_URL).
SO_STORAGE_BACKEND=file
SO_DATABASE_URL=

# Включение внутренних метрик конвейера (1 — включить, иначе выключено).
# При включении эндпоинт GET /metrics возвращает снимок счётчиков и
# гистограмм; см. docs/API.md и src/second_opinion/metrics.py.
SO_METRICS_ENABLED=0

# Максимальный возраст пароля в днях (0 — без ограничения). При превышении
# вход отклоняется 403 «срок действия пароля истёк», смена — через
# POST /auth/change-password действующей сессией или сброс admin.
# Пользователи: in-memory по умолчанию; при SO_STORAGE_BACKEND=postgres
# хранятся в PostgreSQL (таблица users + blacklist + аудит входов).
SO_PASSWORD_MAX_AGE_DAYS=0

# Глубина истории паролей (0 — не проверять повторы): повторное
# использование одного из последних паролей отклоняется 400.
SO_PASSWORD_HISTORY_DEPTH=5

# Блокировка входа: максимум последовательных неудачных попыток (0 — без
# блокировки) и длительность блокировки в минутах (вход — 403, сброс —
# успешный вход после истечения или смена/сброс пароля).
SO_LOGIN_MAX_ATTEMPTS=5
SO_LOGIN_LOCKOUT_MINUTES=15
