# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Environment / secrets
.env
.env.local

# Runtime data (документы, отчёты анализа, аудит-журнал создаются приложением)
data/store/
data/raw/*
data/raw_pravo/
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Артефакты измерения покрытия (НТ-09): данные прогона, не исходник
.coverage
.coverage.*
coverage.xml
htmlcov/

# Evaluation reports are generated artifacts
evaluation/reports/
.last_eval.json
.eval_stdout.json
.eval_stderr.txt

# Рабочие материалы ассистента: заметки о том, как вести разработку.
# К поставляемому продукту не относятся и в репозитории не хранятся.
.claude/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Кэш трассировки истории по ИПС: воспроизводится командой norms-trace-history
data/drafts/norms/*.cache.json
